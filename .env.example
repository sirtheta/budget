# ─────────────────────────────────────────────────────────────────────────────
# Beispielkonfiguration. Für Docker genügt in der Regel gar keine .env:
# AUTH_SECRET und ENCRYPTION_KEY werden beim ersten Start automatisch erzeugt
# und im Daten-Volume abgelegt. Explizit gesetzte Werte haben immer Vorrang.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Datenbank ────────────────────────────────────────────────────────────────
# SQLite-Datei. Im Container liegt sie im gemounteten Volume.
DATABASE_URL="file:./data/budget.db"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Random secret (min. 32 chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Optional in Docker: if unset, a random secret is generated on first start
# and persisted in the data volume (data/secrets.json).
AUTH_SECRET="..."

# Vollständige URL der Anwendung; wird für Weiterleitungen und die Links in
# Passwort-Reset-Mails verwendet.
#
# WICHTIG: Ist die Instanz über HTTPS erreichbar (z. B. hinter einem Reverse
# Proxy), muss hier die https://-Adresse stehen. NextAuth entscheidet anhand
# dieses Werts, ob das Session-Cookie als `Secure` markiert wird — bleibt der
# http-Wert stehen, wird das Cookie auch über unverschlüsselte Verbindungen
# mitgesendet. Beim Start wird andernfalls gewarnt.
AUTH_URL="http://localhost:3000"

# 32-Byte-Schlüssel (hex) für die Verschlüsselung des SMTP-Passworts in der
# Datenbank. Wird der Schlüssel gewechselt, muss das Passwort neu erfasst werden.
#   openssl rand -hex 32
ENCRYPTION_KEY=""

# ── Erster Start ─────────────────────────────────────────────────────────────
# Legt den ersten Admin an, solange noch kein Benutzer existiert. Ohne
# ADMIN_PASSWORD(_HASH) erzeugt der Container ein Einmalpasswort und schreibt es
# nach data/initial-admin-password.txt.
ADMIN_EMAIL="admin@example.ch"
ADMIN_NAME="Admin"
# ADMIN_PASSWORD="bitte-aendern"
# ADMIN_PASSWORD_HASH=""

# ── Zeit und Automatik ───────────────────────────────────────────────────────
# Zeitzone des Servers (Logzeitstempel).
TZ="Europe/Zurich"

# Zeitzone, nach der sich richtet, welcher Kalendertag als "heute" gilt —
# massgebend für fällige wiederkehrende Buchungen. Unabhängig von TZ.
APP_TIMEZONE="Europe/Zurich"

# Cron-Ausdruck für das Buchen fälliger wiederkehrender Buchungen.
# Stündlich, damit ein zwischenzeitlich ausgeschalteter Server am selben Tag
# nachbucht statt erst am nächsten.
RECURRING_CRON_SCHEDULE="5 * * * *"

# Nächtliches Datenbank-Backup (VACUUM INTO nach data/backups/).
BACKUP_CRON_SCHEDULE="30 2 * * *"
# Aufbewahrung der Backup-Dateien in Tagen; 0 = alle behalten.
BACKUP_MAX_KEEP_DAYS="14"

# Aufbewahrung der Audit-Log-Einträge in Tagen; 0 = unbegrenzt.
AUDIT_RETENTION_DAYS="365"

# ── Import ───────────────────────────────────────────────────────────────────
# Maximale Grösse einer hochgeladenen CAMT.053-/CSV-Datei in Bytes.
IMPORT_MAX_FILE_SIZE_BYTES="10485760"

# ── CustomerManagement-Integration ──────────────────────────────────────────
# Öffentliche URL der CustomerManagement-App. Wenn gesetzt, wird nach jedem
# Import geprüft, ob eine eingehende Zahlung zu einer offenen Rechnung dort
# passt (per Rechnungsnummer + Betrag) und diese ggf. als bezahlt markiert.
# Ohne diesen Wert ist die Integration deaktiviert.
# CUSTOMER_MANAGEMENT_URL="https://crm.deine-domain.ch"
# Muss mit BUDGET_INTEGRATION_API_KEY in CustomerManagement übereinstimmen.
# CUSTOMER_MANAGEMENT_API_KEY=""

# ── Session und Rate-Limit ───────────────────────────────────────────────────
# SESSION_MAX_AGE_SEC="604800"
# SESSION_UPDATE_AGE_SEC="86400"
# RATE_LIMIT_MAX_ATTEMPTS="5"
# RATE_LIMIT_WINDOW_MS="900000"
# BCRYPT_ROUNDS="10"
#
# Anzahl Reverse Proxies vor der App ("true" = einer). Nur wenn dieser Wert
# gesetzt ist, wird `x-forwarded-for` für die IP-basierten Rate-Limits
# ausgewertet — der Header ist frei wählbar, ohne bekannte Proxy-Anzahl also
# nicht vertrauenswürdig. Ohne diesen Wert greifen weiterhin die Limits pro
# Konto bzw. E-Mail-Adresse.
# TRUST_PROXY_HEADERS="1"

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL="info"

# ── Schalter für Entwicklung und Staging ─────────────────────────────────────
# DISABLE_EMAIL="true"
# DISABLE_BACKUP="true"
# DISABLE_RECURRING="true"
